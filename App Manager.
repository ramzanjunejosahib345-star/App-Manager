  builder.setTitle(#myApps == 0 and "App Manager: the list is empty. Press ADD AN APP" or ("App Manager: " .. #myApps .. " apps"))
  builder.setCancelable(true)
  local layout = LinearLayout(service)
  layout.setOrientation(1)
  layout.setPadding(40, 20, 40, 20)
  tvStatus = nil
  if #myApps > 0 then
    for i, a in ipairs(myApps) do
      local ab = Button(service)
      ab.setText(a.label)
      pcall(function() ab.setAllCaps(false) end)
      pcall(function() ab.setContentDescription(a.label .. ", app " .. i .. " of " .. #myApps) end)
      layout.addView(ab)
      ab.setOnClickListener{onClick=safe(function() openApp(a) end)}
      pcall(function()
        ab.setOnLongClickListener{onLongClick=function(v)
          pcall(function() appMenu(a) end)
