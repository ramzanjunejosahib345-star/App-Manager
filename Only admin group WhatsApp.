require "import"
import "android.os.Handler"
import "android.os.Looper"
import "java.lang.Runnable"
import "android.view.accessibility.AccessibilityNodeInfo"

-- WhatsApp group: toggle "Send new messages" between Everyone and Only admins.
-- Steps: More options -> Group info -> Group permissions -> Send new messages -> switch -> back to the group.

local handler = Handler(Looper.getMainLooper())
local EVERYONE_WORDS = {"everyone", "all members"}
local ADMIN_WORDS = {"only admins", "admins only"}

local function safeRun(func)
    local ok, err = pcall(func)
    return ok
end

local function setTimeout(ms, action)
    handler.postDelayed(Runnable{
        run = function()
            safeRun(action)
        end
    }, ms)
end

local function say(t)
    pcall(function() service.speak(t) end)
end

local function clickNode(node)
    if not node then return false end
    local ok, res = pcall(function()
        if node.isClickable() then
            return node.performAction(AccessibilityNodeInfo.ACTION_CLICK)
        end
        local current = node.getParent()
        local guard = 0
        while current and guard < 8 do
            if current.isClickable() then
                return current.performAction(AccessibilityNodeInfo.ACTION_CLICK)
            end
            current = current.getParent()
            guard = guard + 1
        end
        return false
    end)
    return ok and res
end

local function scrollDown()
    safeRun(function()
        local root = service.getRootInActiveWindow()
        if not root then return end
        local ok = false
        local scrollableNodes = root.findAccessibilityNodeInfosByViewId("android:id/list")
        if scrollableNodes and scrollableNodes.size() > 0 then
            ok = scrollableNodes.get(0).performAction(AccessibilityNodeInfo.ACTION_SCROLL_FORWARD)
        end
        if not ok then
            local count = root.getChildCount()
            for i = 0, count - 1 do
                local child = root.getChild(i)
                if child and child.isScrollable() then
                    if child.performAction(AccessibilityNodeInfo.ACTION_SCROLL_FORWARD) then
                        ok = true
                        break
                    end
                end
            end
        end
        if not ok then
            root.performAction(AccessibilityNodeInfo.ACTION_SCROLL_FORWARD)
        end
    end)
end

local function findAndClick(keywords)
    local clicked = false
    safeRun(function()
        local root = service.getRootInActiveWindow()
        if not root then return end
        for _, text in ipairs(keywords) do
            local list = root.findAccessibilityNodeInfosByText(text)
            if list and list.size() > 0 then
                for i = 0, list.size() - 1 do
                    local node = list.get(i)
                    if node and node.isVisibleToUser() then
                        if clickNode(node) then
                            clicked = true
                            return
                        end
                    end
                end
            end
        end
    end)
    return clicked
end

-- is anything with one of these texts on the screen?
local function present(keywords)
    local found = false
    safeRun(function()
        local root = service.getRootInActiveWindow()
        if not root then return end
        for _, text in ipairs(keywords) do
            local list = root.findAccessibilityNodeInfosByText(text)
            if list and list.size() > 0 then
                for i = 0, list.size() - 1 do
                    local node = list.get(i)
                    if node and node.isVisibleToUser() then
                        found = true
                        return
                    end
                end
            end
        end
    end)
    return found
end

-- Reads which option of the open window is selected. Looks at every checked item on screen and at the texts around it.
local function nodeTexts(node, depth)
    local t = ""
    pcall(function()
        local x = node.getText()
        if x ~= nil then t = t .. " " .. tostring(x) end
    end)
    pcall(function()
        local x = node.getContentDescription()
        if x ~= nil then t = t .. " " .. tostring(x) end
    end)
    if depth > 0 then
        pcall(function()
            for i = 0, node.getChildCount() - 1 do
                local c = node.getChild(i)
                if c then t = t .. nodeTexts(c, depth - 1) end
            end
        end)
    end
    return t
end

local function containsAny(text, keywords)
    local low = string.lower(text)
    for _, k in ipairs(keywords) do
        if string.find(low, string.lower(k), 1, true) then return true end
    end
    return false
end

-- returns "everyone", "admins" or nil
local function detectSelected()
    local result = nil
    safeRun(function()
        local root = service.getRootInActiveWindow()
        if not root then return end
        local checkedTexts = {}
        local function walk(node, depth)
            if not node or depth > 14 then return end
            local isC = false
            pcall(function() if node.isChecked() then isC = true end end)
            if isC then
                -- the text of the checked item itself, or of its row (parent, then grandparent)
                local t = nodeTexts(node, 2)
                if not (containsAny(t, EVERYONE_WORDS) or containsAny(t, ADMIN_WORDS)) then
                    pcall(function()
                        local p = node.getParent()
                        if p then t = nodeTexts(p, 2) end
                        if not (containsAny(t, EVERYONE_WORDS) or containsAny(t, ADMIN_WORDS)) then
                            local gp = p and p.getParent()
                            if gp then t = nodeTexts(gp, 3) end
                        end
                    end)
                end
                checkedTexts[#checkedTexts + 1] = t
            end
            pcall(function()
                for i = 0, node.getChildCount() - 1 do
                    walk(node.getChild(i), depth + 1)
                end
            end)
        end
        walk(root, 0)
        for _, t in ipairs(checkedTexts) do
            local a = containsAny(t, ADMIN_WORDS)
            local e = containsAny(t, EVERYONE_WORDS)
            if a and not e then result = "admins" return end
            if e and not a then result = "everyone" return end
        end
    end)
    return result
end

local EVERYONE = {"Everyone", "ہر کوئی"}
local ONLYADMINS = {"Only admins", "Only Admins", "صرف ایڈمنز", "صرف منتظمین"}
local ROW = {"Send new messages", "Send messages", "نئے پیغامات بھیجیں", "پیغامات بھیجیں"}
local PERMS = {"Group permissions", "Permissions", "گروپ کے اختیارات", "گروپ کی اجازتیں"}
local INFO = {"Group info", "گروپ کی معلومات", "Group details"}
local SETTINGS_SCREEN = {"Group permissions", "Send new messages", "Media, links", "Edit group settings", "Exit group"}

-- try fn up to `tries` times, every `gap` ms; then call done(ok)
local function retry(fn, tries, gap, done)
    local n = 0
    local function step()
        n = n + 1
        local ok = false
        safeRun(function() ok = fn(n) end)
        if ok then
            done(true)
        elseif n >= tries then
            done(false)
        else
            setTimeout(gap, step)
        end
    end
    step()
end

local finalMessage = ""

local function goBackToGroup()
    local backs = 0
    local function step()
        backs = backs + 1
        service.performGlobalAction(1)
        setTimeout(900, function()
            local stillInside = present(SETTINGS_SCREEN)
            if stillInside and backs < 5 then
                step()
            else
                setTimeout(300, function()
                    say(finalMessage .. " ڈیولپر محمد رمضان قادری")
                end)
            end
        end)
    end
    step()
end

local function switchOption()
    retry(function(n)
        return present(EVERYONE) and present(ONLYADMINS)
    end, 6, 700, function(found)
        if not found then
            finalMessage = "سینڈ نیو میسجز کے آپشن نہیں کھلے۔"
            goBackToGroup()
            return
        end
        local state = detectSelected()
        local goAdmins
        local how = "detected"
        if state == "everyone" then
            goAdmins = true
        elseif state == "admins" then
            goAdmins = false
        else
            -- could not read the selection: do the opposite of what this plugin did last time
            how = "remembered"
            local last = ""
            pcall(function() last = tostring(service.getSharedPreferences("wa_group_toggle", 0).getString("last", "")) end)
            if last == "admins" then goAdmins = false else goAdmins = true end
        end
        local clicked
        if goAdmins then
            clicked = findAndClick(ONLYADMINS)
            finalMessage = "اب صرف ایڈمنز میسج بھیج سکتے ہیں۔"
        else
            clicked = findAndClick(EVERYONE)
            finalMessage = "اب ہر کوئی میسج بھیج سکتا ہے۔"
        end
        if not clicked then
            finalMessage = "آپشن پر کلک نہیں ہو سکا۔"
        else
            pcall(function() service.getSharedPreferences("wa_group_toggle", 0).edit().putString("last", goAdmins and "admins" or "everyone").commit() end)
            if how == "remembered" then finalMessage = finalMessage .. " موجودہ سیٹنگ پڑھی نہیں جا سکی، پچھلی بار کی یاد سے الٹا کیا۔" end
        end
        setTimeout(800, function()
            -- some versions have an OK button in this window
            safeRun(function()
                local root = service.getRootInActiveWindow()
                if not root then return end
                for _, t in ipairs({"OK", "Ok", "ٹھیک ہے"}) do
                    local list = root.findAccessibilityNodeInfosByText(t)
                    if list then
                        for i = 0, list.size() - 1 do
                            local node = list.get(i)
                            local txt = ""
                            pcall(function() txt = tostring(node.getText()) end)
                            if node and node.isVisibleToUser() and (txt == "OK" or txt == "Ok" or txt == "ٹھیک ہے") then
                                clickNode(node)
                                return
                            end
                        end
                    end
                end
            end)
            setTimeout(800, goBackToGroup)
        end)
    end)
end

local function openRow()
    retry(function(n)
        return findAndClick(ROW)
    end, 5, 800, function(ok)
        if not ok then
            finalMessage = "سینڈ نیو میسجز کا آپشن نہیں ملا۔"
            goBackToGroup()
            return
        end
        setTimeout(1000, switchOption)
    end)
end

local function openPermissions()
    retry(function(n)
        if findAndClick(PERMS) then return true end
        scrollDown()
        return false
    end, 6, 900, function(ok)
        if not ok then
            finalMessage = "گروپ پرمیشنز کا آپشن نہیں ملا۔"
            goBackToGroup()
            return
        end
        setTimeout(1100, openRow)
    end)
end

local function openInfo()
    retry(function(n)
        if findAndClick(INFO) then return true end
        if n == 3 then
            safeRun(function() service.click({{"Group info", "گروپ کی معلومات"}}) end)
        end
        return false
    end, 5, 700, function(ok)
        if not ok then
            finalMessage = "گروپ انفو کا آپشن نہیں ملا۔"
            goBackToGroup()
            return
        end
        setTimeout(1300, openPermissions)
    end)
end

safeRun(function()
    service.click({{"More options", "مزید اختیارات", "More", "More options popup"}})
end)

setTimeout(1200, openInfo)

return true